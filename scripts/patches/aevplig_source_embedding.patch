     def forward(self, data):
         x, edge_index, edge_attr, batch = data.x, data.edge_index, data.edge_attr, data.batch
 
+        # Expand the per-graph dataset_idx to one value per node, embed it, and
+        # concatenate onto the node features. Falls back to all-zeros (the
